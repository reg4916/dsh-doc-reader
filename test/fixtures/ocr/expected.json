{
  "ocr-image.png": {
    "format": "image",
    "kind": "image",
    "extension": "png",
    "size": [
      1200,
      400
    ],
    "substrings": [
      "OCR-IMAGE-MARKER",
      "Hello from OCR fixture",
      "Second line 12345"
    ],
    "lines": [
      "OCR-IMAGE-MARKER",
      "Hello from OCR fixture",
      "Second line 12345"
    ],
    "match": {
      "ignoreCase": true,
      "normalizeSpaces": true
    },
    "languages": [
      "eng"
    ],
    "may_fail": false
  },
